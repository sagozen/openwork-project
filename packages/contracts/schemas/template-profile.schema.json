{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templatedesign.zhst.app/contracts/template-profile.schema.json",
  "title": "TemplateDesign template envelope",
  "description": "The controlled `certificate-cfo-v1` profile. The envelope wraps a pdfme template; every element type and every `td` property is allowlisted. Unknown native pdfme properties are rejected by the server preflight, not silently dropped.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "kind", "page", "source", "td"],
  "properties": {
    "profile": { "const": "certificate-cfo-v1" },
    "kind": { "enum": ["certificate", "cfo", "logistics"] },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "orientation", "unit"],
      "properties": {
        "size": { "enum": ["A4", "A6", "100x150", "Letter"] },
        "orientation": { "enum": ["portrait", "landscape"] },
        "unit": { "const": "mm" },
        "backgroundAssetId": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "description": "pdfme Template JSON. Only `schemas` is tightly validated here; other pdfme keys pass through.",
      "required": ["schemas"],
      "properties": {
        "basePdf": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "padding": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0 },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          ]
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/element" }
          }
        }
      }
    },
    "td": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileVersion", "docLocale", "inputSchema"],
      "properties": {
        "profileVersion": { "const": "1.0.0" },
        "docLocale": { "enum": ["en", "vi"] },
        "inputSchema": {
          "type": "object",
          "description": "JSON Schema 2020-12 generated by the schema editor. Must not contain remote $ref values."
        },
        "sampleData": { "type": "object" },
        "guides": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "position"],
            "properties": {
              "axis": { "enum": ["x", "y"] },
              "position": { "type": "number" }
            }
          }
        },
        "locks": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "cfo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sections": {
              "type": "array",
              "maxItems": 60,
              "items": { "$ref": "#/$defs/section" }
            },
            "reconciliation": { "enum": ["fail", "show_unallocated"] }
          }
        }
      }
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["name", "type", "position", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": {
          "enum": ["text", "image", "line", "rect", "ellipse", "qrcode", "code128", "pagenum", "band", "cfo-flow"]
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "rotate": { "type": "number", "minimum": -360, "maximum": 360 },
        "content": {
          "type": "string",
          "description": "Static text only. Braces are rejected by preflight; they are never evaluated."
        },
        "td": { "$ref": "#/$defs/elementTd" }
      }
    },
    "elementTd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["static", "field", "sentence"] },
        "field": { "type": "string", "maxLength": 120 },
        "tokens": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field"],
            "properties": {
              "field": { "type": "string", "maxLength": 120 },
              "format": { "enum": ["asis", "date.en", "date.vi", "number", "money", "page"] },
              "empty": { "type": "string", "maxLength": 40 }
            }
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": { "enum": ["wrap", "shrink", "error"] },
            "min": { "type": "number", "minimum": 4, "maximum": 72 },
            "maxLines": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        },
        "format": { "enum": ["asis", "date.en", "date.vi", "number", "money", "page"] },
        "empty": { "type": "string", "maxLength": 40 },
        "assetId": { "type": "string", "maxLength": 80 },
        "role": { "enum": ["image", "logo", "signature", "background"] },
        "fitMode": { "enum": ["contain", "cover"] },
        "radius": { "type": "number", "minimum": 0, "maximum": 20 },
        "source": { "enum": ["field", "static"] },
        "ecc": { "enum": ["L", "M", "Q", "H"] },
        "includetext": { "type": "boolean" },
        "pattern": { "type": "string", "maxLength": 40 },
        "kind": { "enum": ["header", "footer"] },
        "firstPage": { "type": "boolean" },
        "sections": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/section" } },
        "spacing": { "type": "number", "minimum": 0, "maximum": 40 }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "type", "title"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "enum": ["kpi", "table", "chart", "text", "notes", "break"] },
        "title": { "type": "string", "maxLength": 160 },
        "enabled": { "type": "boolean", "default": true },
        "keepWithNext": { "type": "boolean", "default": false },
        "startOnNewPage": { "type": "boolean", "default": false }
      }
    }
  },
  "x-td-profile": {
    "version": "1.0.0",
    "plugins": [
      "td-text",
      "td-image",
      "td-line",
      "td-rect",
      "td-ellipse",
      "td-qr",
      "td-code128",
      "td-pagenum",
      "td-band",
      "td-cfo-flow"
    ],
    "forbidden": [
      "user JavaScript or expressions",
      "textFormat: inline-markdown",
      "overflow: expand",
      "remote image URLs",
      "fonts outside the curated font set",
      "custom pdfme plugins",
      "Typst source"
    ]
  }
}
