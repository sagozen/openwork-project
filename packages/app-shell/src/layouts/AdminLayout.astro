---
import { CSRF_COOKIE } from "@templatedesign/platform/csrf";

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  /** App navigation, hrefs relative to the workspace root, for example `/admin/floor`. */
  nav?: NavItem[];
  /** The `href` (relative form) of the current page. */
  current?: string;
}

const { title, nav = [], current = "" } = Astro.props;
const { workspace, brand, member } = Astro.locals;
if (!workspace || !brand) throw new Error("AdminLayout needs the app-shell middleware to resolve a workspace");

const base = `/${workspace.slug}`;
const shell: NavItem[] = [
  { href: "/admin/settings/branding", label: "Branding" },
  { href: "/admin/members", label: "Members" },
  { href: "/admin/billing", label: "Billing" },
];
const canManage = member?.role === "owner" || member?.role === "admin";
const items = [...nav, ...(canManage ? shell : [])];
const accent = /^#[0-9a-fA-F]{6}$/.test(brand.accentColor ?? "") ? brand.accentColor : null;
const logoUrl = brand.logoKey ? `/${brand.logoKey}` : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · {brand.displayName}</title>
    <style>
      :root { --brand-accent: #2563eb; --ink: #1c1917; --muted: #78716c; --line: #e7e5e4; --bg: #fafaf9; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 15px/1.5 system-ui, sans-serif; color: var(--ink); background: var(--bg); }
      .shell { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
      .shell__side { background: #fff; border-right: 1px solid var(--line); padding: 20px 16px; display: flex; flex-direction: column; gap: 16px; }
      .shell__brand { display: flex; align-items: center; gap: 10px; font-weight: 650; color: var(--ink); text-decoration: none; }
      .shell__brand img { width: 36px; height: 36px; object-fit: contain; border-radius: 6px; }
      .shell__mark { width: 36px; height: 36px; border-radius: 6px; background: var(--brand-accent); color: #fff; display: grid; place-items: center; font-weight: 700; }
      .shell__nav { display: flex; flex-direction: column; gap: 2px; }
      .shell__nav a { padding: 8px 10px; border-radius: 6px; color: var(--ink); text-decoration: none; }
      .shell__nav a:hover { background: var(--bg); }
      .shell__nav a[aria-current="page"] { background: var(--brand-accent); color: #fff; }
      .shell__main { padding: 28px 32px; max-width: 960px; }
      .shell__main h1 { margin: 0 0 20px; font-size: 22px; }
      .shell__plan { margin-top: auto; color: var(--muted); font-size: 13px; }
      @media (max-width: 720px) { .shell { grid-template-columns: 1fr; } .shell__side { border-right: 0; border-bottom: 1px solid var(--line); } .shell__main { padding: 20px 16px; } }
    </style>
  </head>
  <body style={accent ? `--brand-accent: ${accent}` : undefined}>
    <div class="shell">
      <aside class="shell__side">
        <a class="shell__brand" href={`${base}/admin`}>
          {logoUrl ? <img src={logoUrl} alt="" width="36" height="36" /> : <span class="shell__mark" aria-hidden="true">{brand.displayName.slice(0, 1).toUpperCase()}</span>}
          <span>{brand.displayName}</span>
        </a>
        <nav class="shell__nav" aria-label="Admin">
          {items.map((item) => (
            <a href={`${base}${item.href}`} aria-current={current === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <p class="shell__plan">Plan: {workspace.plan}</p>
      </aside>
      <main class="shell__main">
        <h1>{title}</h1>
        <slot />
      </main>
    </div>
    <script define:vars={{ csrfCookie: CSRF_COOKIE }}>
      window.shellCsrf = () => {
        const match = document.cookie.split("; ").find((part) => part.startsWith(`${csrfCookie}=`));
        return match ? decodeURIComponent(match.slice(csrfCookie.length + 1)) : "";
      };
    </script>
  </body>
</html>
