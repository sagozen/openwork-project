---
import { d1Db } from "@templatedesign/platform/db";
import { runtimeEnv } from "@templatedesign/platform/runtime";
import { getBranding, requireMember } from "@templatedesign/platform/workspaces";
import AdminLayout from "../layouts/AdminLayout.astro";

const { workspace, user } = Astro.locals;
if (!workspace || !user) return new Response("Not found", { status: 404 });
const db = d1Db(runtimeEnv().DB);
try {
  await requireMember(db, workspace, user.id, ["admin"]);
} catch {
  return new Response("Only the owner or an admin can change branding.", { status: 403 });
}
const branding = await getBranding(db, workspace.id);
const logoUrl = branding.logoKey ? `/${branding.logoKey}` : null;
---

<AdminLayout title="Branding" current="/admin/settings/branding">
  <form id="branding-form" data-endpoint={`/${workspace.slug}/admin/api/branding`} style="display:grid;gap:16px;max-width:460px">
    <label>Display name
      <input name="displayName" maxlength="80" value={branding.displayName ?? ""} style="display:block;width:100%;padding:8px" />
    </label>
    <label>Accent colour
      <input name="accentColor" type="color" value={branding.accentColor ?? "#2563eb"} />
    </label>
    <div>
      <p style="margin:0 0 6px">Logo (PNG, JPEG or WebP, up to 512 KB)</p>
      {logoUrl && <img id="logo-preview" src={logoUrl} alt="Current logo" width="72" height="72" style="object-fit:contain;display:block;margin-bottom:8px" />}
      <input id="logo-input" name="logo" type="file" accept="image/png,image/jpeg,image/webp" />
      {logoUrl && <label style="display:block;margin-top:6px"><input name="clearLogo" type="checkbox" value="1" /> Remove logo</label>}
    </div>
    <button type="submit" style="padding:10px 16px;width:fit-content">Save</button>
    <p id="branding-status" role="status" style="margin:0;color:#78716c"></p>
  </form>

  <script>
    const MAX_EDGE = 512;
    const form = document.getElementById("branding-form") as HTMLFormElement;
    const status = document.getElementById("branding-status") as HTMLElement;

    // Shrink big logos in the browser so they stay under the upload limit; WebP keeps them small.
    async function shrink(file: File): Promise<File> {
      if (file.size <= 200 * 1024) return file;
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext("2d")?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob: Blob | null = await new Promise((resolve) => canvas.toBlob(resolve, "image/webp", 0.9));
      return blob ? new File([blob], "logo.webp", { type: "image/webp" }) : file;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.textContent = "Saving…";
      const data = new FormData(form);
      const logo = data.get("logo");
      if (logo instanceof File && logo.size > 0) data.set("logo", await shrink(logo));
      const response = await fetch(form.dataset.endpoint as string, {
        method: "POST",
        body: data,
        headers: { "x-csrf-token": (window as unknown as { shellCsrf: () => string }).shellCsrf() },
      });
      if (response.ok) {
        location.reload();
        return;
      }
      const problem = await response.json().catch(() => null);
      status.textContent = problem?.detail ?? "Could not save.";
    });
  </script>
</AdminLayout>
