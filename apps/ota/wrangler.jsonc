{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ota-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "routes": [{ "pattern": "ota-multiplatform.zhst.app", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "SESSION", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ota-web",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ota-media" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "OTA_MAX_BUNDLE_BYTES": "104857600",
    "OTA_RETENTION_DAYS": "14"
  }
}
