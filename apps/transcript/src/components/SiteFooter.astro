---
import type { Locale } from "@templatedesign/platform/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const vi = locale === "vi";
const columns = [
  {
    title: vi ? "Sản phẩm" : "Product",
    links: [
      { href: "/", label: vi ? "Bóc băng" : "Transcription" },
      { href: "/pricing", label: vi ? "Bảng giá" : "Pricing" },
      { href: "/docs/api", label: "API" },
    ],
  },
  {
    title: vi ? "Nhà phát triển" : "Developers",
    links: [
      { href: "/docs/api", label: vi ? "Tài liệu API" : "API reference" },
      { href: "/docs/webhooks", label: "Webhooks" },
      { href: "/?account=api", label: vi ? "Khoá API" : "API keys" },
    ],
  },
  {
    title: vi ? "Pháp lý" : "Legal",
    links: [
      { href: "/legal#terms", label: vi ? "Điều khoản" : "Terms" },
      { href: "/legal#privacy", label: vi ? "Quyền riêng tư" : "Privacy" },
    ],
  },
];
---

<footer class="ta-footer">
  <div class="ta-footer__inner">
    <div class="ta-footer__brand">
      <a class="td-logo" href="/">
        <span class="td-logo__seal" aria-hidden="true">TA</span>
        <span class="td-logo__word">TranscriptAnything</span>
      </a>
      <p>
        {vi
          ? "Dán liên kết, nhận bản ghi. Tệp dưới 3 phút miễn phí, dài hơn tính theo phút."
          : "Paste a link, get a transcript. Media under 3 minutes is free, longer media is priced per minute."}
      </p>
    </div>
    {columns.map((column) => (
      <div class="ta-footer__col">
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="ta-footer__legal">
    {vi
      ? "Bạn phải sở hữu hoặc có quyền sử dụng nội dung mình tải lên. Liên kết DRM không được hỗ trợ."
      : "You must own or be licensed to use the content you submit. DRM links are not supported."}
  </p>
</footer>
