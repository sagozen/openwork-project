# Copy to .dev.vars for local Cloudflare dev. Never commit .dev.vars.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:4323
APP_ORIGIN=http://localhost:4323
EMAIL_PROVIDER=console
EMAIL_FROM=TranscriptAnything <no-reply@localhost>
EMAIL_DEBUG=1
INTERNAL_SWEEP_SECRET=local-sweep-secret
ADMIN_EMAILS=owner@example.com
# R2 S3 credentials used only to sign upload URLs. Local dev can leave them empty; uploads then
# return 503 while link jobs keep working.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# MEDIA_BUCKET_NAME=transcript-media
# OUTPUTS_BUCKET_NAME=transcript-outputs
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# Turnstile: set BOTH the site key and the secret, or neither.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# PAYMENTS_PROVIDER=paddle
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRODUCT_ID=pro_
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_
