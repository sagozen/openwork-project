# Copy to .dev.vars for local Cloudflare dev. Never commit .dev.vars.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:4336
APP_ORIGIN=http://localhost:4336
EMAIL_PROVIDER=console
EMAIL_FROM=MyArtifacts <no-reply@localhost>
EMAIL_DEBUG=1
ADMIN_EMAILS=owner@example.com
OWNER_EMAILS=owner@example.com
# Contabo Object Storage (S3-compatible). Point at a bucket you can write test objects to.
S3_ENDPOINT=https://usc1.contabostorage.com
S3_REGION=usc1
S3_BUCKET=myartifact
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
