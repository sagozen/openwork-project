{
  "name": "chatqa-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode pwa",
    "dev:desktop": "vite --mode desktop",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "build:desktop:debug": "HS_DEBUG_BUILD=1 npm run build:desktop",
    "build:pwa": "tsc --noEmit && vite build --mode pwa",
    "build:pwa:debug": "HS_DEBUG_BUILD=1 npm run build:pwa",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "visual": "playwright test",
    "visual:baseline": "playwright test --update-snapshots",
    "e2e:release": "npm run build:desktop && playwright test -c playwright.release.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.1.0"
  }
}
