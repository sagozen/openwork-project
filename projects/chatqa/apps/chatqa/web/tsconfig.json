{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "paths": {
      "@shell/*": [
        "../../../packages/ui-shell/src/*"
      ],
      "@product/*": [
        "./src/*"
      ],
      "@contracts/*": [
        "../../../contracts/*"
      ]
    }
  },
  "include": [
    "src",
    "../../../packages/ui-shell/src/vite-env.d.ts"
  ]
}
