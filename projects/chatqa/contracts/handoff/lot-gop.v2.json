{
  "$comment": "Mẫu tệp gộp theo cột ECUS (25 cột A-Y của 'File ECUS Import - DSH 159HG.xls', Sheet1 dòng 1) cộng cột Z 'Dòng gốc' (mã VPO của các dòng gốc, truy vết). App Gộp lô chỉ điền các trường trong 'fill'; các cột còn lại để trống vì quy tắc của chúng (mã biểu thuế, thuế suất, tiền thuế, tỷ giá, Lượng 2) thuộc App Xuất tờ khai (declaration-export-userflow.md dòng 140-147). Thuế suất ghi dạng phần trăm (8 = 8%). Mẫu của khách thay bản này qua Thiết lập mẫu; bản v1 giữ để mở tệp lô cũ.",
  "id": "lot-gop",
  "version": 2,
  "sheet": "^Gộp lô",
  "headerRow": 1,
  "firstDataRow": 2,
  "fill": ["stt", "name", "hs", "origin", "qty", "unit", "invoicePrice", "invoiceValue", "nkPct", "vatPct", "sourceLines"],
  "columns": [
    { "field": "stt", "col": "A", "header": "STT", "required": true },
    { "field": "itemCode", "col": "B", "header": "Mã hàng", "required": false },
    { "field": "name", "col": "C", "header": "Tên hàng (mô tả chi tiết)", "required": true },
    { "field": "hs", "col": "D", "header": "Mã HS", "required": true },
    { "field": "origin", "col": "E", "header": "Xuất xứ", "required": true },
    { "field": "qty", "col": "F", "header": "Lượng", "required": true },
    { "field": "unit", "col": "G", "header": "Đơn vị tính", "required": true },
    { "field": "qty2", "col": "H", "header": "Lượng 2", "required": false },
    { "field": "unit2", "col": "I", "header": "Đơn vị tính 2", "required": false },
    { "field": "invoicePrice", "col": "J", "header": "Đơn giá hóa đơn", "required": true },
    { "field": "invoiceValue", "col": "K", "header": "Trị giá hóa đơn", "required": true },
    { "field": "taxPrice", "col": "L", "header": "Đơn giá tính thuế", "required": false },
    { "field": "taxValue", "col": "M", "header": "Trị giá tính thuế", "required": false },
    { "field": "nkCode", "col": "N", "header": "Mã biểu thuế NK", "required": false },
    { "field": "nkPct", "col": "O", "header": "TS NK(%)", "required": true },
    { "field": "nkAmount", "col": "P", "header": "Tiền thuế NK", "required": false },
    { "field": "ttdbCode", "col": "Q", "header": "Mã biếu thuế TTĐB", "required": false },
    { "field": "ttdbPct", "col": "R", "header": "Thuế suất TTĐB(%)", "required": false },
    { "field": "ttdbAmount", "col": "S", "header": "Tiền thuế TTĐB", "required": false },
    { "field": "envCode", "col": "T", "header": "Mã biểu thuế môi trường", "required": false },
    { "field": "envPct", "col": "U", "header": "Thuế suất môi trường", "required": false },
    { "field": "envAmount", "col": "V", "header": "Tiền thuế môi trường", "required": false },
    { "field": "vatCode", "col": "W", "header": "Mã biểu thuế VAT", "required": false },
    { "field": "vatPct", "col": "X", "header": "Thuế suất VAT(%)", "required": true },
    { "field": "vatAmount", "col": "Y", "header": "Tiền thuế VAT", "required": false },
    { "field": "sourceLines", "col": "Z", "header": "Dòng gốc", "required": true, "note": "Mã VPO của các dòng gốc, cách nhau dấu phẩy; VPO lặp ở nhiều dòng của lô ghi VPO#<dòng Sheet>" }
  ]
}
