{
  "name": "@mytutor/theme-mytutor",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "typecheck": "astro check",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env scripts/preview.mjs",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "secrets:generate": "emdash secrets generate --write .env",
    "cloudflare:build": "astro build --config astro.cloudflare.config.mjs",
    "cloudflare:preview": "wrangler dev --config dist-cloudflare/server/wrangler.json --local --persist-to .wrangler/state"
  },
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.1.1"
    }
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "7.0.1",
    "@mytutor/plugin-mytutor-lms": "file:../../plugins/mytutor-lms",
    "astro": "7.3.5",
    "emdash": "1.2.0",
    "oxc-transform-react": "0.145.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shaka-player": "5.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@emdash-cms/cloudflare": "1.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
