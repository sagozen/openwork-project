---
import Base from '../../layouts/Base.astro';
import OpenCourseCta from '../../components/OpenCourseCta';
import PublicSessions from '../../components/PublicSessions';
import { translator } from '../../i18n';
import { pluginCall } from '../../lib/lms';
import { pageContext } from '../../lib/page-context';
import type { CourseSummary } from '@mytutor/plugin-mytutor-lms/model';
const { locale, session, site } = await pageContext(Astro);
const t = translator(locale);
const result = await pluginCall<CourseSummary[]>(Astro.locals, Astro.url, 'catalog');
if (!result.ok) return new Response(t('courseDetail.unavailable'), { status: 503, headers: { 'Cache-Control': 'no-store' } });
const course = result.data.find((entry) => entry.id === Astro.params.id);
if (!course) return Astro.rewrite('/404');
const open = course.access === 'open';
---
<Base title={course.title} description={course.summary} localized>
  <article class="container course-detail">
    <p class="eyebrow"><a href="/#courses">{t('courseDetail.breadcrumbCatalog')}</a> / {t('courseDetail.breadcrumbCurriculum')}</p>
    <h1>{course.title}</h1>
    <p class="muted">{course.summary}</p>
    <div class="course-meta"><span>{t('courseDetail.byInstructor', { instructor: course.instructor })}</span><span>{t('courseDetail.lessons', { count: course.lessonCount })}</span><span>{t('courseDetail.minutes', { count: course.durationMinutes })}</span></div>
    <div class="course-overview"><div class="prose">{course.description}</div>{open
      ? <OpenCourseCta client:load courseId={course.id} locale={locale} signedIn={session === 'account'} selfSignup={site?.selfSignup ?? false} />
      : <aside class="empty"><h3>{t('courseDetail.access.title')}</h3><p>{t('courseDetail.access.body')}</p><div class="actions"><a class="button" href="/learn">{t('courseDetail.access.myLearning')}</a><a class="text-link" href="/join">{t('courseDetail.access.useInvitation')}</a></div></aside>}</div>
    <PublicSessions client:load sessions={course.upcomingSessions ?? []} locale={locale} />
    <section aria-labelledby="curriculum-title"><p class="eyebrow">{t('courseDetail.curriculum.eyebrow')}</p><h2 id="curriculum-title">{t('courseDetail.curriculum.title')}</h2><ol class="curriculum">{course.curriculum.map((lesson, index) => <li><span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><small>{lesson.module}</small><strong>{lesson.title}</strong></div><span class="time">{t('courseDetail.minutes', { count: lesson.durationMinutes })}</span></li>)}</ol></section>
  </article>
</Base>
