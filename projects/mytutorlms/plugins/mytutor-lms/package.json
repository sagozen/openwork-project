{
  "name": "@mytutor/plugin-mytutor-lms",
  "version": "0.4.0",
  "description": "Private invitation-based course publishing and learning for EmDash",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./admin": "./src/admin/index.tsx",
    "./tokens.css": "./src/design/tokens.css",
    "./icons": "./src/design/icons.ts",
    "./contrast": "./src/design/contrast.ts",
    "./ui": "./src/ui/index.ts",
    "./ui.css": "./src/ui/ui.css",
    "./model": {
      "types": "./src/model.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "tokens:json": "node scripts/tokens-to-json.mjs",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "emdash": "1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "emdash": "1.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
